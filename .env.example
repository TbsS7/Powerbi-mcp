# Copie este arquivo para .env (ou defina as variáveis no bloco "env" do
# claude_desktop_config.json) e ajuste os valores para o seu ambiente.

# Diretório contendo Microsoft.AnalysisServices.Core.dll,
# Microsoft.AnalysisServices.Tabular.dll e
# Microsoft.AnalysisServices.Tabular.Json.dll.
# Normalmente não precisa definir isto: rode "python scripts/setup_tom.py"
# uma vez e o servidor encontra as DLLs automaticamente em .tom-dlls/dlls.
# Só defina TOM_DLL_PATH se quiser usar DLLs de outro lugar (Tabular
# Editor, SSMS, SQL Server SDK) -- veja o README, seção "Licenciamento e
# obtenção do TOM".
TOM_DLL_PATH=

# Qual runtime .NET o pythonnet deve carregar antes do primeiro
# "import clr". O padrão ("coreclr") casa com as DLLs baixadas por
# scripts/setup_tom.py. Só mude para "netfx" se estiver usando DLLs do
# .NET Framework (ex.: as que vêm com o Tabular Editor) -- veja o
# README, seção "Troubleshooting: TypeLoadException ao conectar".
PYTHONNET_RUNTIME=

# Nível de log: DEBUG, INFO, WARNING, ERROR.
POWERBI_MCP_LOG_LEVEL=INFO
